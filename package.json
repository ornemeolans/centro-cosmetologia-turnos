{
  "name": "centro-cosmetologia-turnos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "demo": "concurrently -k -n api,web \"npm:demo:api\" \"npm:demo:web\"",
    "demo:api": "cd apps/api && tsx scripts/e2e-server.ts",
    "demo:web": "cross-env WEB_PORT=5199 API_TARGET=http://localhost:3199 npm run dev --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3"
  }
}
