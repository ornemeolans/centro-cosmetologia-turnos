# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repositorio.
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Valor largo y aleatorio. Para generarlo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=cambiar-por-un-valor-largo-y-aleatorio
# 1 en desarrollo; 2 en producción (rewrite de Vercel + Render)
TRUST_PROXY_HOPS=1

# Base de datos
# - Desarrollo sin Supabase: `npm run db:local --workspace apps/api` y esta URL:
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/turnos
# - Supabase: Project Settings → Database → Connection string → "Session pooler" (funciona con IPv4 y con migraciones):
# DATABASE_URL=postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Email de la cosmetóloga principal: al ingresar con este email recibe el rol OWNER
OWNER_EMAIL=
# Aparecen en los eventos de calendario
CENTER_NAME=Centro de Cosmetología
CENTER_ADDRESS=

# Fotos de fichas en Supabase Storage (bucket privado). Sin esto se guardan en apps/api/uploads (solo desarrollo).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=fichas

# Google OAuth (Google Cloud Console → Credenciales → ID de cliente OAuth "Aplicación web")
# URI de redirección autorizada: http://localhost:5173/api/v1/auth/google/callback (y la de producción)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: por defecto WEB_ORIGIN + /api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# Mercado Pago (aplicación Marketplace del centro; cada profesional conecta su cuenta por OAuth)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# Opcional: por defecto WEB_ORIGIN + /api/v1/oauth/mercadopago/callback (registrala igual en la aplicación de Mercado Pago)
MP_REDIRECT_URI=
# Clave AES-256 en base64 (32 bytes) para cifrar los tokens de cada profesional
TOKEN_ENCRYPTION_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
CENTER_WHATSAPP_NUMBER=5491100000000

# Email desde el Gmail del centro: GMAIL_USER = la dirección, GMAIL_APP_PASSWORD = contraseña de aplicación
# (myaccount.google.com/apppasswords, requiere verificación en 2 pasos). Sin esto, los emails se muestran
# en la consola de la API y en /api/v1/dev/outbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternativa opcional en lugar de Gmail: Resend con dominio propio
EMAIL_API_KEY=
EMAIL_FROM=
# Solo desarrollo: '1' expone GET /api/v1/dev/outbox
ENABLE_DEV_OUTBOX=1

# Cron externo (cron-job.org) → POST /api/v1/internal/tick con header x-cron-secret
CRON_SECRET=cambiar

# Seed: crea una profesional y una ficha de prueba con este email para probar la vinculación
SEED_DEMO_CLIENT_EMAIL=
